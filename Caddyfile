:{$PORT:8080} {
	root * /usr/share/caddy
	encode gzip
	# Keep non-production hosts (the preview environment and the raw
	# *.up.railway.app domains) out of search results. Only the real
	# domain is indexable.
	@notlive not host www.dfchomeimprovement.com dfchomeimprovement.com
	header @notlive X-Robots-Tag "noindex, nofollow"
	# Canonical host: 301 the bare apex → www, preserving path + query.
	# Host-scoped (apex only), so www is unaffected. Live since 2026-06-10
	# (apex DNS moved to Cloudflare, CNAME-flattened to Railway).
	@apex host dfchomeimprovement.com
	redir @apex https://www.dfchomeimprovement.com{uri} permanent

	# Employee portal: reverse-proxy /employee* to the dfc-portal Railway service.
	# The portal app is built under the /employee base path, so paths pass through
	# unchanged (no prefix stripping). Host header is set so Railway routes to it.
	@portal path /employee /employee/*
	handle @portal {
		reverse_proxy https://dfc-portal-production.up.railway.app {
			header_up Host dfc-portal-production.up.railway.app
		}
	}

	# Server-side features (Google rating/reviews, later the AI tools): proxy
	# /api/* to the dfc-api Railway service over the private network. Same
	# environment, same name, so preview talks to preview and production to
	# production. API_UPSTREAM overrides it if the service is ever renamed.
	@api path /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:dfc-api.railway.internal:8080}
	}

	# Static marketing site (everything else).
	handle {
		# Serve trailing-slash URLs (/page/ → page.html). Ad platforms and inbound
		# links often append a slash, and our canonical tags use one; without this
		# they 404. Internal rewrite → 200, preserves the query string.
		# One homepage URL: /index.html 301s to / (Reinstate Labs, 2026-09-09).
		@indexhtml path /index.html
		redir @indexhtml / permanent
		@trailingslash path_regexp dir ^/(.+?)/+$
		rewrite @trailingslash /{re.dir.1}
		# clean URLs: /privacy → privacy.html, /terms → terms.html
		try_files {path} {path}/ {path}.html
		file_server
	}

	# friendly 404 → home
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /index.html
		file_server
	}
}
